ASPNETCORE_ENVIRONMENT=Development

# Local: localhost. Docker Compose sobrescribe DB_HOST=postgres.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=billing
DB_USERNAME=root
DB_PASSWORD=changeme

# --- SUNAT (obligatorio para emisión real) ---
SUNAT_ENVIRONMENT=beta
SUNAT_TAX_REGIME=rus
SUNAT_TAXPAYER_TYPE=natural_with_business
SUNAT_RUC=
SUNAT_SOL_USERNAME=
SUNAT_SOL_PASSWORD=
# Local: ruta absoluta al .pfx. Docker Compose fuerza /certs/sunat-beta-signing.pfx
SUNAT_CERTIFICATE_PATH=
SUNAT_CERTIFICATE_PASSWORD=
SUNAT_GRE_CLIENT_ID=
SUNAT_GRE_CLIENT_SECRET=

# --- Emisor (defaults demo si se dejan vacíos; se crean al arrancar) ---
ISSUER_LEGAL_NAME=EMPRESA DEMO S.A.C.
ISSUER_TRADE_NAME=EMPRESA DEMO
ISSUER_ADDRESS_LINE=AV. DEMO 123
ISSUER_UBIGEO=150101
ISSUER_DEPARTMENT=LIMA
ISSUER_PROVINCE=LIMA
ISSUER_DISTRICT=LIMA

STORAGE_ROOT=./storage
# Vacío = sin auth (solo desarrollo). En producción definir y copiar a erp-api BILLING_SERVICE_API_KEY.
SERVICE_API_KEY=
