# Solo infra compartida del stack Docker (carpeta padre de los 3 repos).
# Secretos de app NO van aquí:
#   APP_KEY / JWT_SECRET     → erp-api/.env
#   SUNAT_* / SERVICE_API_KEY → BillingService/.env
#
# cp .env.example .env

COMPOSE_PROJECT_NAME=confecciones-erika

POSTGRES_USER=root
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

REDIS_PASSWORD=
REDIS_PORT=6379

APP_URL=http://localhost
APP_DEBUG=false

# Incluye la IP/host con el que abras el navegador (LAN/VPS).
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
