@namespace Billing.Infrastructure.Pdf.Templates.Shared
@inherits Microsoft.AspNetCore.Components.ComponentBase
@using Billing.Application.Pdf
@using Microsoft.AspNetCore.Components

<div class="pdf-page @(Model.IsCustom ? "pdf-custom" : "pdf-default")">
    <style>
        html, body { margin: 0; padding: 0; }
        .pdf-page {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
            color: #1f2937;
            width: 100%;
        }
        .pdf-header {
            border-bottom: 2px solid @(Model.Branding.HeaderColor);
            padding-bottom: 12px;
            margin-bottom: 16px;
        }
        .pdf-title {
            font-size: 18px;
            font-weight: 700;
            color: @(Model.Branding.HeaderColor);
            line-height: 1.2;
        }
        .pdf-subtitle {
            font-size: 14px;
            font-weight: 700;
            margin-top: 10px;
            color: @(Model.Branding.HeaderColor);
        }
        .muted { color: #64748b; }
        .logo { height: 48px; max-width: 120px; object-fit: contain; }
        table.header-row { width: 100%; border-collapse: collapse; }
        table.header-row td { vertical-align: top; }
        table.items { width: 100%; border-collapse: collapse; margin-top: 14px; table-layout: fixed; }
        table.items th, table.items td { border: 1px solid #cbd5e1; padding: 6px; word-wrap: break-word; }
        table.items th { background: #f8fafc; font-size: 10px; text-transform: uppercase; text-align: left; }
        table.items td.num { text-align: right; white-space: nowrap; }
        col.line { width: 8%; }
        col.desc { width: 40%; }
        col.qty { width: 10%; }
        col.unit { width: 14%; }
        col.igv { width: 14%; }
        col.total { width: 14%; }
        table.totals { margin-top: 14px; width: 100%; border-collapse: collapse; }
        table.totals td { padding: 4px 0; }
        table.totals .label { text-align: right; padding-right: 12px; color: #64748b; }
        table.totals .value { text-align: right; font-weight: 700; width: 140px; }
        .qr { width: 110px; height: 110px; }
        .footer {
            margin-top: 24px;
            font-size: 9px;
            color: #64748b;
            border-top: 1px solid #e2e8f0;
            padding-top: 10px;
        }
        .meta { margin-top: 16px; }
    </style>

    <div class="pdf-header">
        <table class="header-row">
            <tr>
                @if (Model.IsCustom && !string.IsNullOrWhiteSpace(Model.Branding.LogoDataUri))
                {
                    <td style="width: 130px;">
                        <img src="@Model.Branding.LogoDataUri" alt="Logo" class="logo" />
                    </td>
                }
                <td>
                    <div class="pdf-title">@Model.Branding.CompanyName</div>
                    <div>@Model.Issuer.LegalName</div>
                    <div class="muted">RUC @Model.Issuer.Ruc</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Issuer.AddressLine))
                    {
                        <div class="muted">@Model.Issuer.AddressLine</div>
                    }
                </td>
            </tr>
        </table>
        <div class="pdf-subtitle">@Model.Document.TypeLabel @Model.Document.FullNumber</div>
        <div class="muted">Fecha de emisión: @Model.Document.IssueDate</div>
    </div>

    <div>
        <strong>Receptor:</strong> @Model.Recipient.Name<br />
        <span class="muted">@Model.Recipient.IdentityTypeLabel @Model.Recipient.IdentityNumber</span>
        @if (!string.IsNullOrWhiteSpace(Model.Recipient.Address))
        {
            <br /><span class="muted">@Model.Recipient.Address</span>
        }
    </div>

    @if (Model.RelatedDocuments.Count > 0)
    {
        <div class="meta">
            @foreach (var related in Model.RelatedDocuments)
            {
                <div><strong>Documento relacionado:</strong> @related.TypeLabel @related.FullNumber — @related.Reason</div>
            }
        </div>
    }

    <table class="items">
        <colgroup>
            <col class="line" /><col class="desc" /><col class="qty" /><col class="unit" /><col class="igv" /><col class="total" />
        </colgroup>
        <thead>
            <tr>
                <th>#</th>
                <th>Descripción</th>
                <th>Cant.</th>
                <th>P. unit.</th>
                <th>IGV</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="6">Sin ítems registrados.</td></tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.LineNumber</td>
                        <td>@item.Description</td>
                        <td class="num">@item.Quantity.ToString("0.00")</td>
                        <td class="num">@item.UnitValue.ToString("0.00")</td>
                        <td class="num">@item.IgvAmount.ToString("0.00")</td>
                        <td class="num">@item.Total.ToString("0.00")</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <table class="totals">
        @if (Model.ShowTaxBreakdown)
        {
            <tr>
                <td class="label">Op. gravadas:</td>
                <td class="value">@Model.Totals.Currency @Model.Taxes.TaxableAmount.ToString("0.00")</td>
            </tr>
            <tr>
                <td class="label">IGV (18%):</td>
                <td class="value">@Model.Totals.Currency @Model.Taxes.IgvAmount.ToString("0.00")</td>
            </tr>
        }
        <tr>
            <td class="label">Importe total:</td>
            <td class="value">@Model.Totals.Currency @Model.Totals.PayableAmount.ToString("0.00")</td>
        </tr>
    </table>

    @if (!string.IsNullOrWhiteSpace(Model.Totals.AmountInWords))
    {
        <p class="muted" style="margin-top: 10px;"><em>@Model.Totals.AmountInWords</em></p>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Observation))
    {
        <p><strong>Observaciones:</strong> @Model.Observation</p>
    }

    <table class="header-row meta">
        <tr>
            @if (Model.ShowQr)
            {
                <td style="width: 130px;">
                    <img src="@Model.Qr.PngDataUri" alt="QR" class="qr" />
                </td>
            }
            <td>
                @if (Model.ShowQr)
                {
                    <p><strong>Estado SUNAT:</strong> @Model.Document.SunatStatus</p>
                }
            </td>
        </tr>
    </table>

    <div class="footer">@Model.Branding.FooterText</div>
</div>

@code {
    [Parameter]
    public BillingDocumentPdfViewModel Model { get; set; } = default!;
}
